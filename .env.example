# Copy this file to `.env` and fill in the values.
# Full origin only: scheme + hostname [+ port], NO trailing slash.
#
# ── Local / LAN development ──────────────────────────────────────────────────
# Use your PC's LAN IP (same IP Metro prints in exp://x.x.x.x:8081).
# Works for:
#   • Expo Go on Android/iOS device (native HTTP requests, no CORS)
#   • Expo Web in browser at http://192.168.1.30:8081 (same-site → cookies work)
# Replace the IP with your actual machine IP.
#
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.30:3223
#
# For Android emulator → PC localhost:
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3223
#
# For same-machine browser only (Expo Web at localhost:8081):
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:3223
#
# ── Production (Cloudflare tunnel) ───────────────────────────────────────────
# Must match the NEXTAUTH_URL host on the backend so cookies are accepted.
# The WebView tab loads this URL directly (no CORS needed).
#   EXPO_PUBLIC_API_BASE_URL=https://wa.rawabihypermarket.com
#
# ─────────────────────────────────────────────────────────────────────────────
# Restart Expo after any change: Ctrl+C then  npx expo start -c
